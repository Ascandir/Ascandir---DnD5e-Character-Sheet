<section class="tab asc-tab-overview {{#if asc.setup.needed}}asc-has-setup{{/if}} {{ tab.cssClass }}" data-tab="{{ tab.id }}" data-group="{{ tab.group }}">

    {{!-- Ersteinrichtung --}}
    {{#if asc.setup.needed}}
    <div class="asc-panel asc-framed asc-setup" style="grid-area: setup">
        <div class="asc-panel-header"><i class="fa-solid fa-compass-drafting" inert></i><span>{{ localize "ASCSHEET.Setup.Title" }}</span></div>
        <div class="asc-panel-body asc-setup-body">
            <p class="asc-hint">{{ localize "ASCSHEET.Setup.Hint" }}</p>
            <div class="asc-setup-buttons">
                {{> ".asc-setup-step" done=asc.setup.hasClass allowed=asc.setup.canClass type="class" icon="fa-solid fa-hat-wizard" label="ASCSHEET.Setup.Class" }}
                {{> ".asc-setup-step" done=asc.setup.hasSpecies allowed=asc.setup.canSpecies type="race" icon="fa-solid fa-users" label="ASCSHEET.Setup.Species" }}
                {{> ".asc-setup-step" done=asc.setup.hasBackground allowed=asc.setup.canBackground type="background" icon="fa-solid fa-book-open" label="ASCSHEET.Setup.Background" }}
            </div>
        </div>
    </div>
    {{/if}}

    {{!-- Attribute --}}
    <div class="asc-abilities asc-framed asc-dark-box" style="grid-area: abil">
        {{#each ascAbilities}}
        <div class="asc-ability" data-ability="{{ key }}">
            <i class="asc-ability-icon {{ icon }}" inert></i>
            <a class="asc-ability-label {{ @root.rollableClass }} ability-check" data-action="roll" data-type="ability"
               data-tooltip="{{ localize 'ASCSHEET.RollCheck' }}">{{ label }}</a>
            <div class="asc-ability-score">
                {{#if @root.editable}}
                <input type="text" name="system.abilities.{{ key }}.value" value="{{ source.value }}" placeholder="10" data-dtype="Number">
                {{else}}
                <span>{{ value }}</span>
                {{/if}}
            </div>
            <div class="asc-ability-mod">{{ dnd5e-formatModifier mod }}</div>
            {{#if @root.editable}}
            <button type="button" class="unbutton asc-config" data-action="showConfiguration" data-config="ability"
                    data-tooltip="{{ localize 'DND5E.AbilityConfigure' ability=label }}"><i class="fas fa-cog" inert></i></button>
            {{/if}}
        </div>
        {{/each}}
    </div>

    {{!-- Übungsbonus & Passive Werte --}}
    <div class="asc-side-stats asc-framed asc-dark-box" style="grid-area: side">
        <div class="asc-prof-row">
            <i class="asc-bullet" aria-hidden="true"></i>
            <span class="asc-caps">{{ localize "DND5E.ProficiencyBonus" }}</span>
            <span class="asc-value-box">{{ dnd5e-numberFormat system.attributes.prof signDisplay="always" }}</span>
        </div>
        <div class="asc-passives">
            <div class="asc-passive-head"><i class="asc-bullet asc-bullet--down" aria-hidden="true"></i><span class="asc-caps">{{ localize "ASCSHEET.Passives" }}</span></div>
            <div class="asc-passive-list">
                {{#each ascPassives}}
                <div class="asc-passive" data-key="{{ key }}">
                    <span class="asc-passive-value">{{ value }}</span>
                    <span class="asc-passive-label">{{ label }}</span>
                </div>
                {{/each}}
            </div>
        </div>
    </div>

    {{!-- Fertigkeiten --}}
    <div class="asc-panel asc-framed asc-skills" style="grid-area: skills">
        <div class="asc-panel-header">
            <i class="fa-solid fa-sun" inert></i><span>{{ localize "DND5E.Skills" }}</span>
            <span class="asc-col-heads asc-cols-3"><span>{{ localize "ASCSHEET.Prof" }}</span><span>{{ localize "ASCSHEET.Mod" }}</span><span>{{ localize "ASCSHEET.Total" }}</span></span>
        </div>
        <div class="asc-panel-body asc-scroll">
            <ul class="unlist asc-rows">
                {{#each ascSkills}}
                <li class="asc-row asc-skill" data-key="{{ key }}" {{#if reference}}data-reference-tooltip="{{ reference }}"{{/if}}>
                    <button type="button" class="unbutton asc-fav-dot {{#if favorite}}active{{/if}}" data-action="ascToggleSkillFavorite"
                            data-tooltip="{{ localize 'ASCSHEET.FavoriteToggle' }}"></button>
                    <i class="asc-row-icon {{ icon }}" inert></i>
                    <a class="asc-name draggable {{ @root.rollableClass }} skill-name" data-action="roll" data-type="skill"
                       data-tooltip="{{ abbreviation }} · {{ localize 'ASCSHEET.Passive' }} {{ passive }}">{{ label }}</a>
                    {{#if @root.editable}}
                    <proficiency-cycle type="skill" name="system.skills.{{ key }}.value" value="{{ source.value }}" data-tooltip="{{ hover }}"></proficiency-cycle>
                    {{else}}
                    <span class="asc-check asc-check--{{ profClass }}" data-tooltip="{{ hover }}"></span>
                    {{/if}}
                    <span class="asc-num">{{ dnd5e-formatModifier abilityMod }}</span>
                    <span class="asc-num asc-num--total">{{ dnd5e-formatModifier total }}</span>
                </li>
                {{/each}}
            </ul>
        </div>
    </div>

    {{!-- Rettungswürfe --}}
    <div class="asc-panel asc-framed asc-saves" style="grid-area: saves">
        <div class="asc-panel-header">
            <i class="fa-solid fa-dharmachakra" inert></i><span>{{ localize "DND5E.ClassSaves" }}</span>
            <span class="asc-col-heads asc-cols-3"><span>{{ localize "ASCSHEET.Prof" }}</span><span>{{ localize "ASCSHEET.Mod" }}</span><span>{{ localize "ASCSHEET.Total" }}</span></span>
        </div>
        <div class="asc-panel-body asc-scroll">
            <ul class="unlist asc-rows asc-rows--banded">
                {{#each ascSaves}}
                <li class="asc-row asc-save" data-ability="{{ key }}">
                    <i class="asc-row-icon {{ icon }}" inert></i>
                    <a class="asc-name {{ @root.rollableClass }} saving-throw" data-action="roll" data-type="ability">{{ label }}</a>
                    {{#if @root.editable}}
                    <proficiency-cycle type="ability" name="system.abilities.{{ key }}.proficient" value="{{ source.proficient }}"
                                       data-tooltip aria-label="{{ hover }}"></proficiency-cycle>
                    {{else}}
                    <span class="asc-check asc-check--{{ class }}" data-tooltip="{{ hover }}"></span>
                    {{/if}}
                    <span class="asc-num">{{ dnd5e-formatModifier mod }}</span>
                    <span class="asc-num asc-num--total">{{ dnd5e-formatModifier save.value }}</span>
                </li>
                {{/each}}
                <li class="asc-row asc-save" data-ability="concentration">
                    <i class="asc-row-icon fa-solid fa-brain" inert></i>
                    <a class="asc-name {{ @root.rollableClass }} saving-throw" data-action="roll" data-type="ability">{{ localize "DND5E.Concentration" }}</a>
                    <span></span><span></span>
                    <span class="asc-num asc-num--total">{{ dnd5e-formatModifier ascCombat.concentration }}</span>
                </li>
            </ul>
        </div>
    </div>

    {{!-- Kampf --}}
    <div class="asc-panel asc-framed asc-combat" style="grid-area: combat">
        <div class="asc-panel-header">
            <i class="fa-solid fa-khanda" inert></i><span>{{ localize "ASCSHEET.Tab.combat" }}</span>
            <a class="asc-header-link" data-action="ascGoTab" data-tab="combat" data-tooltip="ASCSHEET.ShowAll"><i class="fa-regular fa-circle-dot" inert></i></a>
        </div>
        <div class="asc-panel-body">
            <div class="asc-combat-stats">
                <div class="asc-stat" data-attribution="attributes.ac" data-attribution-caption="DND5E.ArmorClass">
                    <span class="asc-stat-label">{{ localize "DND5E.ArmorClass" }}</span>
                    <span class="asc-shield"><span>{{ ascCombat.ac }}</span></span>
                </div>
                <div class="asc-stat {{ rollableClass }}" data-action="roll" data-type="initiative">
                    <span class="asc-stat-label">{{ localize "DND5E.Initiative" }}</span>
                    <span class="asc-hex"><span>{{ dnd5e-numberFormat ascCombat.init signDisplay="always" }}</span></span>
                </div>
                <div class="asc-stat">
                    <span class="asc-stat-label">{{ localize "ASCSHEET.Movement" }}</span>
                    <span class="asc-oct"><span>{{ ascCombat.speed }} {{ localize ascCombat.speedUnit }}</span></span>
                </div>
            </div>
            <div class="asc-ribbon"><span>{{ localize "ASCSHEET.Attacks" }}</span><span>{{ localize "ASCSHEET.Damage" }}</span></div>
            <ul class="unlist asc-item-rows asc-scroll">
                {{#each ascAttacks}}
                <li class="asc-item-row asc-attack-row item-tooltip" data-item-id="{{ itemId }}" data-activity-id="{{ activityId }}" data-uuid="{{ item.uuid }}">
                    <img class="asc-item-img" src="{{ img }}" alt="" data-action="showDocument">
                    <div class="asc-item-text {{ @root.rollableClass }}" data-action="ascUseItem">
                        <span class="asc-item-name">{{ name }}</span>
                        <span class="asc-item-sub">{{ subtitle }}</span>
                    </div>
                    {{#if (or toHit damage)}}
                    <span class="asc-cell asc-cell--sep asc-num">{{#if toHit}}{{ toHit }}{{else if save}}{{ save }}{{/if}}</span>
                    <span class="asc-cell asc-cell--sep asc-num asc-dmg">{{ damage }}</span>
                    {{else}}
                    <span class="asc-cell"></span>
                    <span class="asc-cell asc-use-hint {{ @root.rollableClass }}" data-action="ascUseItem">
                        {{#if uses}}<em>{{ uses.value }}/{{ uses.max }}</em>{{/if}}<i class="fa-solid fa-hand-sparkles" inert></i>
                    </span>
                    {{/if}}
                </li>
                {{else}}
                <li class="asc-empty">{{ localize "ASCSHEET.NoAttacks" }}</li>
                {{/each}}
            </ul>
        </div>
    </div>

    {{!-- Zauberwerte --}}
    <div class="asc-panel asc-framed asc-spellstats" style="grid-area: spellstats">
        <div class="asc-panel-header">
            <i class="fa-solid fa-person-rays" inert></i><span>{{ localize "ASCSHEET.Tab.spells" }}</span>
            <a class="asc-header-link" data-action="ascGoTab" data-tab="spells" data-tooltip="ASCSHEET.ShowAll"><i class="fa-regular fa-circle-dot" inert></i></a>
        </div>
        <div class="asc-panel-body">
            {{#if ascSpellcasting}}
            {{#with (lookup ascSpellcasting 0)}}
            <div class="asc-spellcasting">
                <div class="asc-slot-total" data-tooltip="{{ localize 'ASCSHEET.SlotsTotal' }}">
                    <div class="asc-bar asc-bar--mana"><span style="width: {{ @root.ascSlotTotal.pct }}%"></span><em>{{ @root.ascSlotTotal.value }} / {{ @root.ascSlotTotal.max }}</em></div>
                    <div class="asc-slot-gems">{{#each @root.ascSlots}}<i class="fa-solid fa-diamond {{#if empty}}empty{{/if}}" inert></i>{{/each}}</div>
                </div>
                <div class="asc-sc-cell"><span class="asc-sc-label">{{ localize "ASCSHEET.SpellAbility" }}</span><span class="asc-chip">{{ localize ability }}</span></div>
                <div class="asc-sc-cell"><span class="asc-sc-label">{{ localize "ASCSHEET.SpellAttack" }}</span><span class="asc-big">{{ dnd5e-formatModifier attack }}</span></div>
                <div class="asc-sc-cell"><span class="asc-sc-label">{{ localize "ASCSHEET.SpellDC" }}</span><span class="asc-big">{{ save }}</span></div>
            </div>
            {{/with}}
            <div class="asc-slot-tiles">
                {{#each ascSlots}}
                <button type="button" class="asc-slot-tile {{#if empty}}empty{{/if}}" data-action="ascSpendSlot" data-slot="{{ slot }}"
                        data-tooltip="{{ label }}: {{ value }}/{{ max }} – {{ localize 'ASCSHEET.SlotHint' }}">
                    <i class="fa-solid fa-gem" inert></i><span>{{ value }}</span>
                </button>
                {{/each}}
            </div>
            {{else}}
            <p class="asc-empty">{{ localize "ASCSHEET.NoSpellcasting" }}</p>
            {{/if}}
        </div>
    </div>

    {{!-- Zauberliste --}}
    <div class="asc-panel asc-framed asc-spells" style="grid-area: spells">
        <div class="asc-panel-header">
            <i class="fa-solid fa-person-rays" inert></i><span>{{ localize "ASCSHEET.Tab.spells" }}</span>
            <label class="asc-search asc-search--header">
                <i class="fa-solid fa-magnifying-glass" inert></i>
                <input type="text" class="asc-search-input" data-search="spells" placeholder="{{ localize 'ASCSHEET.Search.Spells' }}">
                <button type="button" class="unbutton" data-action="ascClearSearch"><i class="fa-solid fa-xmark" inert></i></button>
            </label>
        </div>
        <div class="asc-panel-body asc-scroll" data-search-scope="spells">
            {{#each ascSpellSections}}
            {{#if spells.length}}
            <div class="asc-spell-group" data-search-group>
                <div class="asc-group-head">
                    <span>{{ label }}</span>
                    <span class="asc-col-heads asc-cols-2"><span>{{ localize "ASCSHEET.SpellRoll" }}</span><span>{{ localize "ASCSHEET.Uses" }}</span></span>
                    {{#if prop}}
                    <div class="pips asc-pips" data-prop="{{ prop }}">
                        {{#each pips}}<button type="button" class="{{ classes }}" data-action="togglePip" data-n="{{ n }}" data-tooltip="{{ tooltip }}" aria-pressed="{{ filled }}"></button>{{/each}}
                    </div>
                    {{else}}<span class="asc-pips-spacer"></span>{{/if}}
                </div>
                <ul class="unlist asc-item-rows">
                    {{#each spells}}
                    <li class="asc-item-row asc-spell-row item-tooltip {{#if (eq prepared false)}}unprepared{{/if}}" data-item-id="{{ id }}" data-uuid="{{ uuid }}" data-search-text="{{ name }}">
                        <img class="asc-item-img" src="{{ img }}" alt="" data-action="showDocument">
                        <div class="asc-item-text {{ @root.rollableClass }}" data-action="ascUseItem">
                            <span class="asc-item-name">{{ name }}{{#if concentration}} <i class="fa-solid fa-c asc-conc" inert></i>{{/if}}{{#if (eq prepared true)}} <i class="fa-solid fa-sun asc-prepared" inert></i>{{/if}}</span>
                            <span class="asc-item-sub">{{ subtitle }}</span>
                        </div>
                        <span class="asc-cell asc-cell--sep">{{ roll }}</span>
                        <span class="asc-cell asc-cell--sep">{{ uses }}</span>
                        <a class="asc-chevron" data-action="showDocument"><i class="fa-solid fa-chevron-right" inert></i></a>
                    </li>
                    {{/each}}
                </ul>
            </div>
            {{/if}}
            {{else}}
            <p class="asc-empty">{{ localize "ASCSHEET.NoSpells" }}</p>
            {{/each}}
        </div>
    </div>

    {{!-- Inventar --}}
    <div class="asc-panel asc-framed asc-inventory" style="grid-area: inv">
        <div class="asc-panel-header">
            <i class="fa-solid fa-box-open" inert></i><span>{{ localize "ASCSHEET.Tab.inventory" }}</span>
            <a class="asc-header-link" data-action="ascGoTab" data-tab="inventory" data-tooltip="ASCSHEET.ShowAll"><i class="fa-regular fa-circle-dot" inert></i></a>
        </div>
        <div class="asc-panel-body">
            <label class="asc-search">
                <i class="fa-solid fa-magnifying-glass" inert></i>
                <input type="text" class="asc-search-input" data-search="inventory" placeholder="{{ localize 'ASCSHEET.Search.Inventory' }}">
                <button type="button" class="unbutton" data-action="ascClearSearch"><i class="fa-solid fa-xmark" inert></i></button>
            </label>
            <div class="asc-inv-head"><span></span><span>{{ localize "Name" }}</span><span>{{ localize "ASCSHEET.Price" }}</span><span>{{ localize "ASCSHEET.Weight" }}</span><span>{{ localize "ASCSHEET.Qty" }}</span></div>
            <ul class="unlist asc-item-rows asc-scroll" data-search-scope="inventory">
                {{#each ascInventory}}
                <li class="asc-item-row asc-inv-row item-tooltip" data-item-id="{{ id }}" data-uuid="{{ uuid }}" data-search-text="{{ name }} {{ subtitle }}">
                    <img class="asc-item-img" src="{{ img }}" alt="" data-action="showDocument">
                    <div class="asc-item-text {{ @root.rollableClass }}" data-action="ascUseItem">
                        <span class="asc-item-name">{{ name }}{{#if equipped}} <i class="fa-solid fa-shield-halved asc-equipped" inert></i>{{/if}}</span>
                        <span class="asc-item-sub">{{ subtitle }}</span>
                    </div>
                    <span class="asc-cell asc-cell--sep">{{ price }}{{#if priceIcon}}<img class="asc-coin-icon" src="{{ priceIcon }}" alt="" data-tooltip="{{ priceLabel }}">{{/if}}</span>
                    <span class="asc-cell asc-cell--sep">{{ weight }}</span>
                    <span class="asc-cell asc-cell--sep">{{ quantity }}</span>
                </li>
                {{else}}
                <li class="asc-empty">{{ localize "ASCSHEET.NoItems" }}</li>
                {{/each}}
            </ul>
            <div class="asc-encumbrance {{#if ascEncumbrance.encumbered}}encumbered{{/if}}" data-tooltip="DND5E.Encumbrance">
                <span class="asc-enc-icon"><i class="fa-solid fa-weight-hanging" inert></i></span>
                <div class="asc-bar asc-bar--enc"><span style="width: {{ ascEncumbrance.pct }}%"></span><em>{{ ascEncumbrance.value }} / {{ ascEncumbrance.max }}</em></div>
            </div>
            <div class="asc-currency">
                {{#each ascCurrency}}
                <label class="asc-coin" data-tooltip="{{ label }}">
                    <img src="{{ icon }}" alt="{{ abbr }}">
                    {{#if @root.owner}}
                    <input type="text" name="{{ name }}" value="{{ value }}" data-dtype="Number" inputmode="numeric" pattern="[+=\-]?\d*">
                    {{else}}
                    <span>{{ value }}</span>
                    {{/if}}
                </label>
                {{/each}}
            </div>
        </div>
    </div>

    {{!-- Untere Reihe --}}
    <div class="asc-bottom-row" style="grid-area: bottom">

        {{!-- Merkmale --}}
        <div class="asc-panel asc-framed asc-features">
            <div class="asc-panel-header">
                <i class="fa-solid fa-book-open-reader" inert></i><span>{{ localize "ASCSHEET.Features.Title" }}</span>
            </div>
            <div class="asc-panel-body asc-scroll">
                {{#each ascFeatureGroups}}
                <details class="asc-feature-group" open>
                    <summary>
                        <i class="fa-solid fa-caret-down asc-caret" inert></i>
                        <span>{{ label }}</span>
                        <a class="asc-chevron" data-action="ascGoTab" data-tab="features"><i class="fa-solid fa-chevron-right" inert></i></a>
                    </summary>
                    <ul class="unlist asc-chips">
                        {{#each items}}
                        <li class="asc-chip-item item-tooltip" data-item-id="{{ id }}" data-uuid="{{ uuid }}">
                            <a class="{{ @root.rollableClass }}" data-action="ascUseItem">{{ name }}</a>{{#if uses}} <em>{{ uses }}</em>{{/if}}
                        </li>
                        {{/each}}
                    </ul>
                </details>
                {{else}}
                <p class="asc-empty">{{ localize "ASCSHEET.NoFeatures" }}</p>
                {{/each}}
            </div>
        </div>

        {{!-- Effekte --}}
        <div class="asc-panel asc-framed asc-conditions">
            <div class="asc-panel-header">
                <i class="fa-solid fa-person-rays" inert></i><span>{{ localize "ASCSHEET.Tab.effects" }}</span>
            </div>
            <div class="asc-panel-body">
                <label class="asc-search">
                    <i class="fa-solid fa-magnifying-glass" inert></i>
                    <input type="text" class="asc-search-input" data-search="effects" placeholder="{{ localize 'ASCSHEET.Search.Effects' }}">
                    <button type="button" class="unbutton" data-action="ascClearSearch"><i class="fa-solid fa-xmark" inert></i></button>
                    <a class="asc-chevron" data-action="ascGoTab" data-tab="effects" data-tooltip="ASCSHEET.ShowAll"><i class="fa-solid fa-list" inert></i></a>
                </label>
                <ul class="unlist asc-condition-grid" data-search-scope="effects">
                    {{#each ascConditions}}
                    <li class="asc-condition {{#if active}}active{{/if}}" data-condition="{{ id }}" data-action="ascToggleCondition"
                        data-search-text="{{ name }}" {{#if reference}}data-reference-tooltip="{{ reference }}"{{/if}}>
                        <img src="{{ img }}" alt="">
                        <span>{{ name }}</span>
                        {{#if isExhaustion}}<em class="asc-exhaustion-level" data-tooltip="ASCSHEET.ExhaustionHint">{{ level }}</em>{{/if}}
                    </li>
                    {{/each}}
                </ul>
            </div>
        </div>

        {{!-- Hintergrund --}}
        <div class="asc-panel asc-framed asc-background">
            <div class="asc-panel-header">
                <i class="fa-solid fa-fan" inert></i><span>{{ localize "ASCSHEET.Tab.biography" }}</span>
            </div>
            <div class="asc-panel-body">
                <ul class="unlist asc-bg-grid">
                    {{#each ascBackground}}
                    <li data-action="ascGoTab" data-tab="biography" data-tooltip="{{#if text}}{{ text }}{{else}}–{{/if}}">
                        <i class="{{ icon }}" inert></i><span>{{ label }}</span>
                    </li>
                    {{/each}}
                    <li class="asc-bg-wide" data-action="ascGoTab" data-tab="biography" data-tooltip="{{#if ascBiography}}{{ ascBiography }}{{else}}–{{/if}}">
                        <i class="fa-solid fa-book" inert></i><span>{{ localize "ASCSHEET.Background.biography" }}</span>
                        <i class="fa-solid fa-chevron-right asc-chevron" inert></i>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>

{{#*inline ".asc-setup-step"}}
<button type="button" class="asc-setup-step {{#if done}}done{{/if}}" data-action="findItem" data-item-type="{{ type }}"
        {{#if (or done (not allowed))}}disabled{{/if}}
        {{#unless (or done allowed)}}data-tooltip="ASCSHEET.Warn.NoEditRights"{{/unless}}>
    <i class="{{#if done}}fa-solid fa-circle-check{{else if allowed}}{{ icon }}{{else}}fa-solid fa-lock{{/if}}" inert></i>
    <span>{{ localize label }}</span>
</button>
{{/inline}}
